# WellSim Backend — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# In production the server REFUSES TO START without TOKEN_SECRET and
# DEVICE_API_KEY, rather than silently falling back to a value that is
# published in this repository.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Secrets (required in production, min. 16 chars) ─────────────────

# Signs session tokens. Anyone who knows this can mint a doctor account
# and sign off AI screening results.
TOKEN_SECRET=

# Sent by the ESP32 firmware as the `X-Device-Key` header. Without it,
# anyone can post fabricated recordings into a patient's record.
DEVICE_API_KEY=

# ─── Staff registration ──────────────────────────────────────────────
# Required to create a `nurse` or `doctor` account through the signup
# form. Leave blank to disable staff self-registration entirely, which
# is the right setting for a real deployment — create staff accounts
# administratively instead.
STAFF_REGISTRATION_CODE=

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production only).
CORS_ORIGINS=http://localhost:3000,https://wellsim.pages.dev

# ─── Tuning ──────────────────────────────────────────────────────────
DEVICE_OFFLINE_THRESHOLD_MS=30000
MAX_HISTORY_PER_DEVICE=100
